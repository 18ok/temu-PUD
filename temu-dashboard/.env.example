# 复制本文件为 .env 并填写（.env 勿提交 Git）
# Key 仅保存在本地服务器，浏览器不再保存 Secret

TEMU_OSS_ACCESS_KEY_ID=
TEMU_OSS_ACCESS_KEY_SECRET=
TEMU_OSS_BUCKET=temu-shujufenxi-data
TEMU_OSS_REGION=oss-cn-hangzhou
TEMU_OSS_PREFIX=temu/

# 数据边界：新数据会写入
# ${TEMU_OSS_PREFIX}workspaces/{workspace_id}/companies/{company_id}/projects/{project_id}/...
# 公司数据可以进入运行时，但代码架构和数据边界必须可剥离、可迁移。
TEMU_WORKSPACE_ID=default
TEMU_COMPANY_ID=personal
TEMU_PROJECT_ID=temu
TEMU_PLATFORM=temu
TEMU_DATA_SENSITIVITY=company_internal

# 云端 API 部署
# 本机默认 8080；阿里云 ECS / 轻量服务器可改为 80/443 后由 Nginx 反代到本端口
TEMU_API_HOST=0.0.0.0
TEMU_API_PORT=8080

# 前端访问协作 API 的公开地址
# 本机试点：http://localhost:8080
# 阿里云正式：https://api.example.com
TEMU_PUBLIC_API_BASE=http://localhost:8080

# 协作版（用户/小组/PK 索引同样存 scoped OSS 的 collab/ 目录）
# JWT 签名密钥：生产环境务必改成随机长字符串
TEMU_JWT_SECRET=

# 可选：自定义首次启动时写入 OSS 的邀请码（默认 TEMU-OPS-2026 / TEMU-LEAD-2026 / TEMU-ADMIN-2026）
# TEMU_COLLAB_OPS_INVITE=TEMU-OPS-2026
# TEMU_COLLAB_LEAD_INVITE=TEMU-LEAD-2026
# TEMU_COLLAB_ADMIN_INVITE=TEMU-ADMIN-2026
